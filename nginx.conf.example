# ============================================================================
# 嘉环声枢录音文件传输服务 —— nginx 子路由配置片段
#
# 把下面两段合并进现有的 server { listen 40000 ssl; ... } 块，
# 与 /voicehub/（管理后台静态资源）、/voicehub-api/（设备管理后端）并列。
#
#  topology:
#    浏览器 ──> https://office.uassist.cn:40000
#                ├── /voicehub/        → frontend/ 静态资源
#                ├── /voicehub-api/    → 设备管理后端 127.0.0.1:8040
#                └── /voicehub-ogg/    → 文件传输服务 127.0.0.1:8050  (本文件)
# ============================================================================

# 不带尾斜杠访问时补齐，避免页面里相对路径解析出错
location = /voicehub-ogg {
    return 301 /voicehub-ogg/;
}

location ^~ /voicehub-ogg/ {
    # 必须 >= filetransfer 的 MAX_UPLOAD_MB + multipart 表单开销。
    # 否则大文件会被 nginx 先拦成 413，客户端看不到服务端的结构化错误体。
    client_max_body_size      120m;
    client_body_buffer_size   1m;
    client_body_timeout       300s;

    # 流式转发：nginx 不先把整个请求体缓存到磁盘再转发。
    # 大录音文件上传时建议开启；若后端需要完全收完才处理，也可保持默认 on。
    proxy_request_buffering   off;

    # ★ 关键：proxy_pass 末尾不带 URI（连斜杠都不能带），原样透传
    #   /voicehub-ogg/upload → http://127.0.0.1:8050/voicehub-ogg/upload
    # 若写成 proxy_pass http://127.0.0.1:8050/; 会剥离前缀 → 全部 404。
    proxy_pass                http://127.0.0.1:8050;
    proxy_http_version        1.1;

    proxy_set_header          Host $host;
    proxy_set_header          X-Real-IP $remote_addr;
    proxy_set_header          X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header          X-Forwarded-Proto $scheme;
    # Authorization 默认就会透传，显式写出便于排障与审计；
    # 严禁把令牌写进 access log 或任何自定义日志变量。
    proxy_set_header          Authorization $http_authorization;

    proxy_connect_timeout     10s;
    proxy_send_timeout        300s;
    proxy_read_timeout        300s;
}
