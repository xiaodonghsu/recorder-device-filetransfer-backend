# ============================================================================
# 嘉环声枢录音文件传输服务（filetransfer）—— 环境变量样例
# 复制为 filetransfer/.env 后按实际环境修改。
# 注意：本文件与 backend/.env 相互独立，改这里不会影响设备管理后端。
# ============================================================================

# ---------- 应用 ----------
APP_ENV=development
DEBUG=false
# 服务自身监听的接口前缀。nginx 必须「原样透传」，不剥离该前缀：
#   浏览器 → https://office.uassist.cn:40000/voicehub-ogg/upload
#   nginx  → http://127.0.0.1:8050/voicehub-ogg/upload
# Windows / Git Bash 陷阱：不要直接写 `API_PREFIX=/voicehub-ogg python ...`，
# MSYS 会把它转成 Windows 绝对路径，导致接口 404。请写进本文件，
# 或先执行 `export MSYS_NO_PATHCONV=1`。
API_PREFIX=/voicehub-ogg
# 是否开放 /voicehub-ogg/docs、/redoc、/openapi.json
DOCS_ENABLED=true
# 仅 `python -m app.main` 本地开发使用；生产用 uvicorn 命令行参数指定
HOST=127.0.0.1
PORT=8030

# ---------- 存储 ----------
# 目录级别固定为 <租户名>/<用户名(工号)>/<设备SN>/[subdir]/<文件名>
#   · 租户 / 工号由 Casdoor Token 推导，客户端无法伪造
#   · 设备 SN 由 APP 上传时以表单字段 device_sn 提供（必填），服务端严格净化
#   · 同一工号名下多台录音卡各占一个设备目录，互不混放
#   · 旧的 租户/工号/ 两级布局不做兼容，升级需重建历史索引与目录
# 文件根目录；相对路径以 filetransfer/ 为基准。生产请指向独立磁盘/挂载卷。
STORAGE_DIR=./data/uploads
# 单个文件上限（MB）。nginx 的 client_max_body_size 必须 >= 该值 + 表单开销
MAX_UPLOAD_MB=100
# 扩展名白名单（填 * 表示不限制，生产不建议）
ALLOWED_EXTENSIONS=.ogg,.oga,.opus,.wav,.mp3,.m4a,.flac,.webm
# 客户端可通过 subdir 指定的最大子目录层数（位于设备 SN 目录之内）
MAX_SUBDIR_DEPTH=3
# 同名文件是否覆盖；false 时自动追加 -1 / -2 后缀
OVERWRITE_EXISTING=false
# 列表接口单用户最多返回的文件数
MAX_LIST_ITEMS=1000
# 文件标签：上传表单 tags 支持逗号（中英文均可）分隔，可用 PUT /files/{relpath}/tags 整体覆盖
# 单个文件最多标签数（去重后），超限 422，不做静默截断
MAX_TAGS_PER_FILE=20
# 单个标签最大字符数，超限 422
MAX_TAG_LENGTH=32

# ---------- 存储后端 ----------
# local = 本地文件系统（默认）；obs = 华为云 OBS（官方 Python SDK）
# 切换后端只影响新上传的文件；已有文件的记录带 backend 字段，不会串用。
STORAGE_BACKEND=local

# ---------- 华为云 OBS（STORAGE_BACKEND=obs 时生效）----------
# AK / SK 是长期凭证，只放在 .env 中（已加入 .gitignore），严禁提交代码库。
OBS_ACCESS_KEY_ID=
OBS_SECRET_ACCESS_KEY=
# 桶所在区域 Endpoint；可只写域名，服务会自动补 https://
OBS_SERVER=obs.cn-south-1.myhuaweicloud.com
OBS_BUCKET=delocalization-public-files
# 桶内统一前缀，最终对象键（设备 SN 是强制的一级目录）：
#   obs://<bucket>/<OBS_PREFIX>/<tenant_id>/<user_id>/<device_sn>/<subdir>/<filename>
# 例：obs://delocalization-public-files/voicehub/sounds/bestlink/JH000059/VH-2026-0001/a.ogg
OBS_PREFIX=voicehub/sounds
# OBS 无真实目录；开启后上传以 / 结尾的 0 字节对象，控制台可按层级浏览
# 首次上传会创建 前缀 / 租户 / 用户 / 设备SN 四级目录对象（按设备分别缓存）
OBS_CREATE_FOLDER=true
OBS_MAX_LIST_KEYS=1000

# ---------- 元数据数据库 ----------
# 记录每次上传的文件名、租户、工号、对象键、大小、SHA-256 等，供后续业务使用。
# 本地开发：SQLite（相对路径以 filetransfer/ 为基准）
DATABASE_URL=sqlite:///./data/filetransfer.db
# 生产 / 多实例：MySQL 8.0+
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/voicehub_files?charset=utf8mb4
DB_ECHO=false

# ---------- Casdoor 认证 ----------
# Casdoor 实例配置了 authPrefix=auth，所有接口都在 /auth 之下：
#   /auth/api/userinfo、/auth/api/login/oauth/introspect、/auth/.well-known/jwks
CASDOOR_BASE_URL=https://office.uassist.cn:40000/auth
# JWT 模式校验签发方时用；留空则取 CASDOOR_BASE_URL
CASDOOR_ISSUER=
# clientId 是公开标识符，代码里已内置默认值；应用改名后请在 Casdoor 后台复核
CASDOOR_CLIENT_ID=6932b8ce0b655b9421b5
# clientSecret 是机密，只在 introspect 模式需要；请从 Casdoor 后台复制，勿提交代码库
CASDOOR_CLIENT_SECRET=
# 组织名即 tenant_id，与设备管理后端保持一致
CASDOOR_ORGANIZATION=bestlink
# 校验方式：
#   auto       = userinfo 优先，失败且配了 clientSecret 时回退 introspect（默认）
#   userinfo   = 调用 /api/userinfo 换取用户对象（无需 clientSecret）
#   introspect = RFC7662 服务端校验（需要 clientSecret，最严谨）
#   jwt        = JWKS 本地验签（性能最好，首次需联网拉公钥）
CASDOOR_VERIFY_METHOD=auto
CASDOOR_TIMEOUT=10
# 自签证书场景可设为 false
CASDOOR_VERIFY_TLS=true
CASDOOR_JWKS_CACHE_TTL=3600
# 要求 Token 中的组织与 CASDOOR_ORGANIZATION 一致，防止其它组织用户使用本服务
CASDOOR_REQUIRE_ORGANIZATION=true

# ---------- 安全 ----------
# 是否允许 ?access_token= 传令牌（方便 APP/浏览器直接下载）。
# 默认关闭：URL 会被 nginx、浏览器历史与 access log 记录，有泄漏风险。
ALLOW_QUERY_TOKEN=false
# 多个来源用英文逗号分隔；nginx 同源代理时用不到 CORS
CORS_ORIGINS=https://office.uassist.cn:40000
